<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFF7FC">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#5E35B1"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PantryWise helps you keep track of ingredients, expiry dates and recipes."
            android:textColor="#5F5360"
            android:textSize="18sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Warnings"
            android:textColor="#5E35B1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry warnings appear when an ingredient has expired or is within 3 days of its expiry date."
            android:textColor="#5F5360"
            android:textSize="17sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Suggestions"
            android:textColor="#5E35B1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes shows recipes that can be made using the ingredients currently stored in your pantry. All required ingredients must be available before a recipe is suggested."
            android:textColor="#5F5360"
            android:textSize="17sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About PantryWise"
            android:textColor="#5E35B1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PantryWise helps users manage their pantry, keep track of food quantities and expiry dates, and find recipes using ingredients they already have."
            android:textColor="#5F5360"
            android:textSize="17sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>