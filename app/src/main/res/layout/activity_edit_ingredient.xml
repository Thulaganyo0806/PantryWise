<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pantrywise_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Ingredient"
            android:textColor="@color/pw_dark_purple"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp" />

        <EditText
            android:id="@+id/edtEditName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingredient name"
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/edtEditQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/edtEditUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit (grams, pieces, ml, etc.)"
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/edtEditExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry date"
            android:inputType="text"
            android:layout_marginBottom="25dp" />

        <Button
            android:id="@+id/btnUpdateIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Ingredient"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/pantrywise_button"
            android:textColor="@color/pw_white" />

    </LinearLayout>

</ScrollView>